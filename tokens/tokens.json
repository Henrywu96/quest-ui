{
  "$description": "Quest UI v0: the shared design tokens behind Henry Wu's Portfolio and Quest Town. This file is the single source of truth. Edit it, then run `npm run tokens` to regenerate tokens/quest-ui.css.",
  "color": {
    "$type": "color",
    "coral": {
      "300": { "$value": "#f6a68f", "$description": "Text and glows on dark panels (7.2:1 on navy)." },
      "500": { "$value": "#ec6a4e", "$description": "Brand coral for illustration, decoration and large fills. Not for text or button backgrounds: 3.1:1 with white." },
      "600": { "$value": "#ba472d", "$description": "Primary buttons and all coral text: 5.2:1 with white." }
    },
    "navy": {
      "900": { "$value": "#202b45", "$description": "Headings, dark panels, text on gold." }
    },
    "slate": {
      "500": { "$value": "#646e84", "$description": "Secondary text: at least 4.5:1 on every surface." },
      "600": { "$value": "#5b6478", "$description": "Body text." }
    },
    "cream": {
      "50": { "$value": "#fdf6f1", "$description": "Page background." },
      "100": { "$value": "#fbeee7", "$description": "Inset cards." }
    },
    "peach": {
      "100": { "$value": "#fbe3d8", "$description": "Illustration grounds and hover fills." }
    },
    "line": { "$value": "#f0ddd2", "$description": "Borders." },
    "sky": {
      "200": { "$value": "#cfe9fb", "$description": "The sky behind the hero and the town." }
    },
    "sun": {
      "300": { "$value": "#ffd166", "$description": "Sun, stars, sparks." }
    },
    "gold": {
      "500": { "$value": "#e6a400", "$description": "LEGENDARY badge background (with navy text)." }
    },
    "rare": {
      "600": { "$value": "#2563eb", "$description": "RARE badge background." }
    },
    "epic": {
      "600": { "$value": "#7c3aed", "$description": "EPIC badge background." }
    },
    "ok": {
      "500": { "$value": "#2fb67c", "$description": "Done and success states." }
    },
    "white": { "$value": "#ffffff" }
  },

  "role": {
    "$description": "What each colour is for. Components use these, never the raw colours above.",
    "$type": "color",
    "text": {
      "heading": { "$value": "{color.navy.900}" },
      "body": { "$value": "{color.slate.600}" },
      "muted": { "$value": "{color.slate.500}" },
      "accent": { "$value": "{color.coral.600}" },
      "on-accent": { "$value": "{color.white}" },
      "on-dark": { "$value": "{color.white}" },
      "accent-on-dark": { "$value": "{color.coral.300}" }
    },
    "surface": {
      "page": { "$value": "{color.cream.50}" },
      "card": { "$value": "{color.white}" },
      "inset": { "$value": "{color.cream.100}" },
      "glass": { "$value": "#ffffffd1", "$description": "White at 82%, used with the glass blur." },
      "dark": { "$value": "{color.navy.900}" },
      "sky": { "$value": "{color.sky.200}" }
    },
    "border": {
      "default": { "$value": "{color.line}" }
    },
    "action": {
      "primary": { "$value": "{color.coral.600}" }
    },
    "focus": {
      "ring": { "$value": "{color.coral.600}", "$description": "At least 3:1 against every surface." }
    },
    "rarity": {
      "common": {
        "bg": { "$value": "{color.slate.500}" },
        "text": { "$value": "{color.white}" }
      },
      "rare": {
        "bg": { "$value": "{color.rare.600}" },
        "text": { "$value": "{color.white}" }
      },
      "epic": {
        "bg": { "$value": "{color.epic.600}" },
        "text": { "$value": "{color.white}" }
      },
      "legendary": {
        "bg": { "$value": "{color.gold.500}" },
        "text": { "$value": "{color.navy.900}" }
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fredoka", "Nunito", "Trebuchet MS", "system-ui", "sans-serif"] },
      "body": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$description": "Nine steps. The hero is one step with a phone size (hero) and a desktop size (hero-lg).",
      "$type": "dimension",
      "2xs": { "$value": "11px", "$description": "Smallest interface text: badges and tags." },
      "xs": { "$value": "12px" },
      "sm": { "$value": "13px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "32px" },
      "hero": { "$value": "52px" },
      "hero-lg": { "$value": "64px" }
    },
    "line-height": {
      "$type": "number",
      "none": { "$value": 1 },
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.25 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.6 }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": "0em" },
      "label": { "$value": "0.06em", "$description": "Buttons, badges and other small labels." },
      "eyebrow": { "$value": "0.18em", "$description": "Upper-case section labels such as CASE STUDY." }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Badges." },
    "md": { "$value": "12px", "$description": "Buttons, inputs, small cards." },
    "lg": { "$value": "16px", "$description": "Cards." },
    "xl": { "$value": "24px", "$description": "Large cards and panels." },
    "full": { "$value": "9999px", "$description": "Pills and avatars." }
  },

  "space": {
    "$description": "A 4px grid.",
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },

  "size": {
    "$type": "dimension",
    "control": {
      "md": { "$value": "44px", "$description": "Default button height; also the minimum touch target." },
      "sm": { "$value": "36px", "$description": "Small buttons and icon buttons." }
    },
    "focus": {
      "width": { "$value": "2px" },
      "offset": { "$value": "2px" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "#202b451f", "offsetX": "0px", "offsetY": "3px", "blur": "8px", "spread": "0px" } },
    "md": { "$value": { "color": "#202b4521", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } },
    "lg": { "$value": { "color": "#202b4547", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "0px" } },
    "glow-coral": { "$value": { "color": "#ec6a4ee6", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "-12px" }, "$description": "Under primary buttons." },
    "glow-gold": { "$value": { "color": "#ffc157bf", "offsetX": "0px", "offsetY": "0px", "blur": "40px", "spread": "0px" }, "$description": "Around legendary items." }
  },

  "glass": {
    "blur": { "$type": "dimension", "$value": "16px" },
    "saturate": { "$type": "number", "$value": 1.35 }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms", "$description": "Hover and press feedback." },
      "base": { "$value": "300ms", "$description": "Most transitions." },
      "slow": { "$value": "600ms", "$description": "Entrances and reveals." }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.8, 0.2, 1] },
      "overshoot": { "$value": [0.2, 1.3, 0.4, 1], "$description": "A small bounce at the end, for pop-ins." }
    },
    "spring": {
      "$description": "For motion/react: transition={{ type: 'spring', stiffness, damping }}.",
      "$type": "number",
      "snappy": {
        "$description": "Hover pops.",
        "stiffness": { "$value": 420 },
        "damping": { "$value": 24 }
      },
      "smooth": {
        "$description": "Tilts and position changes.",
        "stiffness": { "$value": 300 },
        "damping": { "$value": 30 }
      },
      "soft": {
        "$description": "Following the scroll.",
        "stiffness": { "$value": 260 },
        "damping": { "$value": 40 }
      }
    }
  },

  "type": {
    "$description": "Text styles. Each becomes a .qu-type-* class in CSS and a text style in Figma.",
    "$type": "typography",
    "h1": {
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.hero}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.tracking.normal}" },
      "$extensions": { "quest-ui": { "desktop": { "fontSize": "{font.size.hero-lg}" } } }
    },
    "h2": {
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.tracking.normal}" },
      "$extensions": { "quest-ui": { "desktop": { "fontSize": "{font.size.3xl}" } } }
    },
    "h3": {
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xl}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.tracking.normal}" }
    },
    "h4": {
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.lg}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.tracking.normal}" }
    },
    "body-lg": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.lg}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.tracking.normal}" }
    },
    "body": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.md}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.tracking.normal}" }
    },
    "small": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.tracking.normal}" }
    },
    "caption": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.tracking.normal}" }
    },
    "eyebrow": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.tracking.eyebrow}" },
      "$extensions": { "quest-ui": { "textTransform": "uppercase" } }
    },
    "label": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.2xs}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.tracking.label}" },
      "$extensions": { "quest-ui": { "textTransform": "uppercase" } }
    },
    "button": {
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.md}", "lineHeight": "{font.line-height.none}", "letterSpacing": "{font.tracking.normal}" }
    }
  },

  "$extensions": {
    "quest-ui": {
      "desktopMinWidth": "768px",
      "contrast": {
        "$description": "Pairs checked on every build. `over` is what a see-through background sits on.",
        "pairs": [
          { "text": "role.text.heading", "on": "role.surface.page", "min": 4.5 },
          { "text": "role.text.heading", "on": "role.surface.sky", "min": 4.5 },
          { "text": "role.text.body", "on": "role.surface.page", "min": 4.5 },
          { "text": "role.text.body", "on": "role.surface.inset", "min": 4.5 },
          { "text": "role.text.body", "on": "role.surface.glass", "over": "role.surface.sky", "min": 4.5 },
          { "text": "role.text.muted", "on": "role.surface.card", "min": 4.5 },
          { "text": "role.text.muted", "on": "role.surface.page", "min": 4.5 },
          { "text": "role.text.muted", "on": "role.surface.inset", "min": 4.5 },
          { "text": "role.text.muted", "on": "role.surface.glass", "over": "role.surface.sky", "min": 4.5 },
          { "text": "role.text.accent", "on": "role.surface.card", "min": 4.5 },
          { "text": "role.text.accent", "on": "role.surface.page", "min": 4.5 },
          { "text": "role.text.accent", "on": "role.surface.inset", "min": 4.5 },
          { "text": "role.text.accent", "on": "role.surface.glass", "over": "role.surface.sky", "min": 4.5 },
          { "text": "role.text.accent", "on": "role.surface.sky", "min": 3, "note": "large text only" },
          { "text": "role.text.on-accent", "on": "role.action.primary", "min": 4.5 },
          { "text": "role.text.on-dark", "on": "role.surface.dark", "min": 4.5 },
          { "text": "role.text.accent-on-dark", "on": "role.surface.dark", "min": 4.5 },
          { "text": "role.rarity.common.text", "on": "role.rarity.common.bg", "min": 4.5 },
          { "text": "role.rarity.rare.text", "on": "role.rarity.rare.bg", "min": 4.5 },
          { "text": "role.rarity.epic.text", "on": "role.rarity.epic.bg", "min": 4.5 },
          { "text": "role.rarity.legendary.text", "on": "role.rarity.legendary.bg", "min": 4.5 },
          { "text": "role.focus.ring", "on": "role.surface.page", "min": 3, "note": "non-text" },
          { "text": "role.focus.ring", "on": "role.surface.inset", "min": 3, "note": "non-text" },
          { "text": "role.focus.ring", "on": "role.surface.sky", "min": 3, "note": "non-text" }
        ]
      }
    }
  }
}
